# ==========================================
# NagrikQ n8n Service Environment Configuration
# ==========================================

# Server Host & Protocol (Render uses 0.0.0.0 and automatically binds PORT)
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http
NODE_ENV=development

# Webhook Base URL (Crucial for external triggers)
# In production on Render, set this to your Render service URL (e.g. https://nagrikq-n8n.onrender.com/)
WEBHOOK_URL=http://localhost:5678/

# Shared Secret Header Key (Must match backend x-webhook-secret)
WEBHOOK_SECRET=nagrikq_idp_secret_key_2026

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=8874803375:AAECsJ9jyBd8d-LlcNJMEpt1ZyYGqYbkHzQ

# Frontend Application Portal URL
FRONTEND_URL=http://localhost:5173

# Security & Credentials Encryption Key (REQUIRED for Render production restarts)
# Generate a secure 32-byte secret string or random hash
N8N_ENCRYPTION_KEY=nagrikq_n8n_encryption_secret_key_2026

# Data Pruning Settings
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=false

# Optional PostgreSQL Database Configuration (Required for Persistent Data on Render)
# DB_TYPE=postgresdb
# DB_POSTGRESDB_HOST=dpg-xxxxx.render.com
# DB_POSTGRESDB_PORT=5432
# DB_POSTGRESDB_DATABASE=nagrikq_n8n_db
# DB_POSTGRESDB_USER=nagrikq_n8n_user
# DB_POSTGRESDB_PASSWORD=your_db_password
